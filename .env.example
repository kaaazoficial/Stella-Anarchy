ANARCHY_BOT_TOKEN=
ANARCHY_WEBHOOK_SECRET=
ANARCHY_COMMUNITY_BOT_TOKEN=
ADMIN_UIDS=
# Extra administrators; kept separate from the owner UID.
ADDITIONAL_ADMIN_UIDS=
SINNER_UID=
COMMAND_PREFIX=!
ANARCHY_API_BASE=https://api.anarchyapps.org/bot-api/v1
DATA_DIR=./data
LOG_LEVEL=INFO

# Cloudflare Workers AI is primary when the private gateway token is configured.
# Otherwise Stella falls back to Gemini, Groq, then Z.AI.
STELLA_AI_PRIMARY_PROVIDER=cloudflare
CLOUDFLARE_AI_GATEWAY_URL=https://anarchy-worker.jeanblanco774.workers.dev/internal/infer
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_AI_MAX_INPUT_TOKENS=3600
CLOUDFLARE_AI_MAX_OUTPUT_TOKENS=900
# Google supports both names. GOOGLE_API_KEY takes precedence when both are set.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Dedicated optional key for semantic embeddings; overrides the general key only here.
GEMINI_EMBEDDING_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/responses
# Conservative request budgets; compact history only, never available tools/features.
GROQ_MAX_INPUT_TOKENS=3600
GROQ_TPM_BUDGET=7000
GROQ_ESTIMATED_OUTPUT_TOKENS=900
GEMINI_MAX_INPUT_TOKENS=5200
# Z.AI is a free-tier optional fallback. GLM-4.7-Flash has free API pricing.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_API_URL=https://api.z.ai/api/paas/v4
ZAI_MAX_INPUT_TOKENS=3600
ZAI_MAX_OUTPUT_TOKENS=900

# Optional catalog and speech defaults.
JAMENDO_CLIENT_ID=
TTS_VOICE=es-CL-CatalinaNeural
MUSIC_AI_SEARCH=1
PROMETHEUS_METRICS_TOKEN=

# Qdrant storage shared by the persistent archive and optional AI memory.
QDRANT_URL=
QDRANT_API_KEY=

# Full chronological archive of all Anarchy room events in Qdrant.
# Uses QDRANT_URL and QDRANT_API_KEY already configured below; separate collection.
# No automatic expiry: messages, edits, deletions and room activity remain in the archive.
QDRANT_ROOM_ARCHIVE_COLLECTION=stella_room_archive

# Automatic personal AI memory in Qdrant; members can opt out with !memoria desactivar.
QDRANT_AI_MEMORY_COLLECTION=stella_ai_memory
# Short-lived semantic message memory (only indexed for members who enabled it).
QDRANT_COLLECTION=stella_messages
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Keep this equal to the existing Qdrant collection size unless you migrate it.
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_CACHE_TTL_SECONDS=180
GEMINI_EMBEDDING_CACHE_SIZE=256
QDRANT_SCORE_THRESHOLD=0.35
MEMORY_RETENTION_DAYS=30
MEMORY_CLEANUP_INTERVAL_SECONDS=21600
AI_MEMORY_RETENTION_DAYS=30
AI_MEMORY_CLEANUP_INTERVAL_SECONDS=21600
# Background retention worker polling interval (seconds; default 900, 15 minutes).
MEMORY_MAINTENANCE_INTERVAL_SECONDS=900
