ANARCHY_BOT_TOKEN=
ANARCHY_WEBHOOK_SECRET=
ANARCHY_COMMUNITY_BOT_TOKEN=
ADMIN_UIDS=
# Extra administrators; kept separate from the owner UID.
ADDITIONAL_ADMIN_UIDS=
SINNER_UID=
COMMAND_PREFIX=!
ANARCHY_API_BASE=https://api.anarchyapps.org/bot-api/v1
DATA_DIR=./data
LOG_LEVEL=INFO

# Gemini is primary; Groq is the fallback provider.
STELLA_AI_PRIMARY_PROVIDER=gemini
# Google supports both names. GOOGLE_API_KEY takes precedence when both are set.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/responses

# Optional catalog and speech defaults.
JAMENDO_CLIENT_ID=
TTS_VOICE=es-CL-CatalinaNeural
MUSIC_AI_SEARCH=1
PROMETHEUS_METRICS_TOKEN=

# Automatic personal AI memory in Qdrant; members can opt out with !memoria desactivar.
QDRANT_AI_MEMORY_COLLECTION=stella_ai_memory
AI_MEMORY_RETENTION_DAYS=30
AI_MEMORY_CLEANUP_INTERVAL_SECONDS=21600
# Background retention worker polling interval (seconds; default 900, 15 minutes).
MEMORY_MAINTENANCE_INTERVAL_SECONDS=900
