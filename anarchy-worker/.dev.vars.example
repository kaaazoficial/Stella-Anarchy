# Secret generated by the Anarchy bot developer portal. Never commit real values.
ANARCHY_WEBHOOK_SECRET="replace-with-webhook-secret"

# Needed only when ANARCHY_REPLY_MODE=api (asynchronous delivery).
ANARCHY_API_URL="https://replace-with-the-real-anarchy-api-base/v1"
ANARCHY_BOT_TOKEN="replace-with-bot-token"
ANARCHY_BOT_ID="replace-with-bot-id"

# Set only if Anarchy's webhook specification uses different header names or signing bytes.
ANARCHY_SIGNATURE_HEADER="X-Anarchy-Signature"
ANARCHY_TIMESTAMP_HEADER="X-Anarchy-Timestamp"
ANARCHY_SIGNATURE_FORMAT="timestamp-dot-body"

ANARCHY_REPLY_MODE="direct"
